# Copy to .env (never commit .env). No credentials belong in this file.

# --- Which engine transcribes
# local = Faster-Whisper in this process (the ASR_MODEL / ASR_DEVICE settings below apply)
# remote = the existing Thai ASR service on DGX 100 (Typhoon Audio / Whisper large-v3). Thai only: English is refused (HTTP 422).
ASR_ENGINE=local
ASR_REMOTE_URL=http://192.168.200.100:5001
ASR_REMOTE_TIMEOUT_S=30

# --- Faster-Whisper model (ASR_ENGINE=local)
# Alias, Hugging Face repo id, or a local CTranslate2 model directory.
# large-v3-turbo is the production choice (GPU). On a CPU-only laptop use "small" or "base" while developing.
ASR_MODEL=large-v3-turbo
# auto = cuda when a GPU is visible, otherwise cpu
ASR_DEVICE=auto
# auto = float16 on cuda, int8 on cpu
ASR_COMPUTE_TYPE=auto
ASR_CPU_THREADS=0
# Where model files are cached (empty = Hugging Face default cache)
ASR_DOWNLOAD_ROOT=
# true = load the model at startup (first call is then fast); false = load on the first request
ASR_PRELOAD=false

# --- Decoding
# th | en | auto. auto detects the language but only accepts ASR_ALLOWED_LANGUAGES; anything else is decoded
# again as ASR_FALLBACK_LANGUAGE (Whisper often mislabels short Thai phone speech).
ASR_LANGUAGE=auto
ASR_ALLOWED_LANGUAGES=th,en
ASR_FALLBACK_LANGUAGE=th
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
# Spelling hint for civic vocabulary. Thai text, so it is only used when the audio is decoded as Thai. Empty = off.
ASR_INITIAL_PROMPT=สายด่วน กทม. 1555 แจ้งเหตุ ท่อระบายน้ำ ทางเท้า ไฟฟ้าสาธารณะ สำนักงานเขต ซอยสุขุมวิท
# Simultaneous transcriptions per process (keep 1 unless the GPU has headroom)
ASR_MAX_CONCURRENCY=1
ASR_MAX_UPLOAD_MB=25

# --- Live stream (WebSocket) utterance detection
# RMS (0..1) a 30 ms frame needs to count as speech. Raise it on noisy lines, lower it for quiet callers.
ASR_ENERGY_THRESHOLD=0.012
ASR_ENDPOINT_SILENCE_MS=700
ASR_PARTIAL_INTERVAL_MS=1500
ASR_MIN_SPEECH_MS=250
ASR_MAX_UTTERANCE_S=20

# --- Hand-off to the CivicVoice API (same host in production)
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_S=5
# true = forward whenever an interaction_id is supplied
FORWARD_DEFAULT=true

# --- HTTP (restrict in production)
CORS_ORIGINS=*
ASR_PORT=5001
