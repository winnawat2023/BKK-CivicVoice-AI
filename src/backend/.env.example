# Copy to .env (never commit .env). No credentials belong in this file.

# --- Thai LLM (vLLM, OpenAI-compatible). Measured reachable at DGX 101 :8001, model id "typhoon-8b".
VLLM_URL=http://192.168.200.101:8001/v1/chat/completions
VLLM_MODEL=typhoon-8b
VLLM_API_KEY=
LLM_ENABLED=true
# Measured ~13 tok/s: a classification reply (~40 tokens) takes ~2.5-3 s. Slower than this -> rules fallback.
LLM_TIMEOUT_S=8
LLM_JSON_MODE=false

# --- Civic RAG
# false = answer instantly from curated regulation snippets (recommended with a slow LLM)
RAG_USE_LLM=false
RAG_TIMEOUT_S=1.8
RAG_MIN_SCORE=0.22
RAG_TOP_K=3

# --- Storage / sessions
DB_PATH=../../data/tickets.db
SESSION_TTL_S=3600

# --- HTTP (restrict in production)
CORS_ORIGINS=*
PORT=8000
