# Copy this file to src/backend/sms.env. The real file is ignored by Git.
SMS_MODE=disabled
SMS_VOICEBOT_ORIGIN=http://127.0.0.1:8000
SMS_PUBLIC_ORIGIN=http://127.0.0.1:8765
SMS_BROWSER_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Defaults to a separate SQLite file for each mode under data/.
SMS_DB_PATH=
SMS_DAILY_LIMIT=20
SMS_PER_NUMBER_DAILY_LIMIT=3

# For SMS_MODE=thaibulksms.
THAIBULKSMS_API_KEY=
THAIBULKSMS_API_SECRET=
THAIBULKSMS_SENDER=

# For SMS_MODE=smskub. The Console API key goes in the key header.
SMSKUB_API_KEY=
SMSKUB_SENDER=

# Required for live modes. List your own verified test numbers.
SMS_ALLOWED_RECIPIENTS=
SMS_CONFIRM_SECRET=

# Optional private credential for reading evidence from authorized backend tools.
SMS_ADMIN_TOKEN=
