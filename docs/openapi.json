  "components": {
    "schemas": {
      "DispatchRequest": {
        "properties": {
          "interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Id"
          }
        },
        "type": "object",
        "title": "DispatchRequest"
      },
      "GenesysWebhookPayload": {
        "properties": {
          "interaction_id": {
            "type": "string",
            "minLength": 1,
            "title": "Interaction Id",
            "description": "Genesys Conversation ID"
          },
          "ani": {
            "type": "string",
            "title": "Ani",
            "description": "Caller phone number (not stored in the ticket)",
            "default": ""
          },
          "dnis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dnis",
            "description": "Dialed number"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "voice"
          },
          "transcript": {
            "type": "string",
            "minLength": 1,
            "title": "Transcript",
            "description": "Recognized Thai speech text"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "interaction_id",
          "transcript"
        ],
        "title": "GenesysWebhookPayload",
        "description": "Webhook body. design.md §3.1 names the speech field ``text_or_audio_stream``; the first\nprototype (and simulate_call.py) used ``transcript``. Both are accepted."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OutboundCallRequest": {
        "properties": {
          "phone_number": {
            "type": "string",
            "title": "Phone Number"
          },
          "ticket_id": {
            "type": "string",
            "title": "Ticket Id"
          },
          "resolution_summary": {
            "type": "string",
            "title": "Resolution Summary"
          },
          "district": {
            "type": "string",
            "title": "District",
            "default": "คลองเตย"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "default": "th"
          }
        },
        "type": "object",
        "required": [
          "phone_number",
          "ticket_id",
          "resolution_summary"
        ],
        "title": "OutboundCallRequest"
      },
      "SegmentPayload": {
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "speaker": {
            "type": "string",
            "enum": [
              "caller",
              "bot",
              "agent"
            ],
            "title": "Speaker",
            "default": "caller"
          },
          "is_final": {
            "type": "boolean",
            "title": "Is Final",
            "default": true
          },
          "ani": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ani"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SegmentPayload",
        "description": "One piece of live transcript (ASR partial/final) pushed into the gateway."
      },
      "StatusUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "รับเรื่องแล้ว",
              "กำลังดำเนินการ",
              "แก้ไขเสร็จ"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusUpdate"
      },
      "TextRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoicebotChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "User voice transcript"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "default": "th"
          },
          "conversation_history": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation History"
          },
          "interaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Id",
            "description": "When set, a complaint also creates a ticket"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "VoicebotChatRequest"
      }
    }
  }
}