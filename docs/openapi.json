      "post": {
        "summary": "Trigger Outbound Call",
        "description": "Proactive AI call telling the citizen their ticket was resolved (Genesys Outbound API hook).",
        "operationId": "trigger_outbound_call_api_v1_outbound_call_citizen_post",
        "requestBody": {
          "content": {
            "application/json": {
