    "/api/v1/tts/synthesize": {
      "get": {
        "summary": "Synthesize Speech",
        "description": "Thai (Premwadee) / English (Andrew) neural voice via edge-tts, returned as audio/mpeg.",
        "operationId": "synthesize_speech_api_v1_tts_synthesize_get",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
