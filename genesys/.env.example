# ---------------------------------------------------------------------------
# HTTP / WSS server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Path that the Genesys Cloud Audio Connector integration points at.
# The full endpoint is:  wss://<your-host><AUDIOHOOK_PATH>
AUDIOHOOK_PATH=/api/v1/audiohook/ws

# Optional TLS for local/direct WSS. Genesys Cloud production requires a
# public CA certificate (or terminate TLS at a public LB/reverse proxy).
# Leave blank to run plain ws:// (dev only).
SSL_CERTFILE=
SSL_KEYFILE=
SSL_CA_CERTS=

# ---------------------------------------------------------------------------
# Genesys Cloud client authentication (Audio Connector integration)
# ---------------------------------------------------------------------------
# X-API-KEY configured on the Genesys Audio Connector integration.
GENESYS_API_KEY=change-me
# Client secret configured on the same integration. Used to verify the
# RFC 9421 HMAC-SHA256 signature of the WebSocket upgrade request.
GENESYS_CLIENT_SECRET=change-me-too

# Turn request signature verification on/off. Keep enabled in production.
AUDIOHOOK_VERIFY_SIGNATURE=true
# Development convenience: allow connections that carry no signature at all.
# NEVER enable this in production.
AUDIOHOOK_ALLOW_UNSIGNED=false
# Maximum age (seconds) allowed for the signature "created" parameter.
AUDIOHOOK_MAX_SIGNATURE_AGE=30

# ---------------------------------------------------------------------------
# AI provider: "openai" (Realtime), "gemini" (Live), or "typhoon" (vLLM cascade)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai

# ---------------------------------------------------------------------------
# OpenAI Realtime API
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=alloy
# pcmu = G.711 mu-law 8kHz passthrough (no resampling, recommended for telephony)
# pcm  = PCM16 24kHz (server resamples 8k<->24k)
OPENAI_AUDIO_FORMAT=pcmu
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONNECT_TIMEOUT=4.0
OPENAI_INSTRUCTIONS=You are a friendly and concise phone assistant. Speak and respond only in Thai or English. Never use any other language. If the caller speaks another language, politely reply in Thai or English and explain that only Thai and English are supported.

# ---------------------------------------------------------------------------
# Google Gemini Live API (used when AI_PROVIDER=gemini)
# API key from Google AI Studio: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Gemini Live is PCM16 only: input 16 kHz, output 24 kHz. The bridge converts
# to/from the Genesys G.711 mu-law 8 kHz stream automatically.
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000
GEMINI_INSTRUCTIONS=You are a friendly and concise phone assistant. Speak and respond only in Thai or English. Never use any other language. If the caller speaks another language, politely reply in Thai or English and explain that only Thai and English are supported.
GEMINI_CONNECT_TIMEOUT=8.0
GEMINI_ENABLE_TRANSCRIPTION=true
# Audio-only Live sessions are capped at ~15 minutes; resumption + context
# compression let a long call continue on a new socket.
GEMINI_SESSION_RESUMPTION=true
GEMINI_RECONNECT_ATTEMPTS=2
GEMINI_CONTEXT_WINDOW_COMPRESSION=true
GEMINI_VAD_PREFIX_MS=300
GEMINI_VAD_SILENCE_MS=600
# Text used to trigger the opening line (empty => BOT_GREETING_INSTRUCTIONS).
GEMINI_GREETING_PROMPT=

# ---------------------------------------------------------------------------
# Typhoon / vLLM self-hosted (used when AI_PROVIDER=typhoon)
# Cascade: Genesys PCMU -> STT -> Typhoon chat-completions -> TTS -> PCMU
# ---------------------------------------------------------------------------
TYPHOON_BASE_URL=http://127.0.0.1:8001/v1
TYPHOON_API_KEY=
TYPHOON_MODEL=typhoon-8b
TYPHOON_INSTRUCTIONS=You are a friendly and concise phone assistant. Speak and respond only in Thai or English. Never use any other language. If the caller speaks another language, politely reply in Thai or English and explain that only Thai and English are supported.
TYPHOON_CONNECT_TIMEOUT=10.0
TYPHOON_MAX_TOKENS=200
TYPHOON_TEMPERATURE=0.3

# STT: OpenAI-compatible /audio/transcriptions (e.g. faster-whisper-server/speaches)
TYPHOON_STT_BASE_URL=http://127.0.0.1:5001/v1
TYPHOON_STT_API_KEY=
TYPHOON_STT_MODEL=large-v3-turbo
TYPHOON_STT_LANGUAGE=

# TTS: edge_tts (like BKK-CivicVoice-AI) or openai (/audio/speech compatible)
TYPHOON_TTS_PROVIDER=edge_tts
TYPHOON_TTS_BASE_URL=http://127.0.0.1:8002/v1
TYPHOON_TTS_API_KEY=
TYPHOON_TTS_MODEL=tts-1
TYPHOON_TTS_VOICE=th-TH-PremwadeeNeural
TYPHOON_TTS_SPEED=1.0

# Simple VAD for cascade turn-taking
TYPHOON_VAD_SILENCE_MS=700
TYPHOON_VAD_ENERGY_THRESHOLD=180
TYPHOON_MAX_UTTERANCE_S=15.0

# ---------------------------------------------------------------------------
# Bot behaviour (shared by all providers)
# ---------------------------------------------------------------------------
BOT_GREETING=true
BOT_GREETING_INSTRUCTIONS=Greet the caller warmly in one short sentence and ask how you can help.

# ---------------------------------------------------------------------------
# Transcript webhook (optional)
# Receives a JSON POST after each finalized caller/bot turn.
# If webhook fails (or URL is empty) and fallback dir is set, transcripts are
# appended as JSONL files in that directory.
# ---------------------------------------------------------------------------
TRANSCRIPT_WEBHOOK_URL=
# Use civic_segments with a URL ending in /api/v1/calls/{interaction_id}/segments.
TRANSCRIPT_WEBHOOK_FORMAT=turn
TRANSCRIPT_WEBHOOK_TIMEOUT=5.0
TRANSCRIPT_WEBHOOK_BEARER_TOKEN=
TRANSCRIPT_FALLBACK_DIR=

# ---------------------------------------------------------------------------
# Genesys server -> client audio pacing
# Protocol guidance: do not send audio more often than every 200 ms and no more
# than 64,000 bytes per binary frame.
# ---------------------------------------------------------------------------
GENESYS_SERVER_AUDIO_CHUNK_MS=200
GENESYS_MAX_BINARY_FRAME_BYTES=64000
